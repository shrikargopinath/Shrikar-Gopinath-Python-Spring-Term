    "    \n",
    "    kmeans = KMeans(\n",
    "        n_clusters=k,\n",
    "        random_state=42\n",
    "    )\n",
    "    \n",
    "    kmeans.fit(tfidf_matrix)\n",
    "    \n",
    "    inertia_values.append(kmeans.inertia_)"
